{
  "name": "open-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/run.mjs",
    "benchmark": "tsc --noEmit --project benchmarks/tsconfig.json && node benchmarks/run.mjs",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "tokens:validate": "node scripts/vendor/validate-tokens.cjs --dir src/"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@solar-icons/react": "^2.3.2",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "apca-w3": "^0.1.9",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "react": "^19.1.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.1.0",
    "react-hotkeys-hook": "^5.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.1",
    "react-test-renderer": "^19.3.0",
    "sass-embedded": "^1.105.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
